{
  "name": "hitl-ui",
  "version": "0.1.0",
  "description": "Human-in-the-loop UI components for AI agents — shadcn-style installable triads of React component + tool definition + agent instructions.",
  "keywords": [
    "hitl",
    "human-in-the-loop",
    "ai",
    "agent",
    "agent-ui",
    "cli",
    "shadcn",
    "components",
    "tool-call"
  ],
  "license": "MIT",
  "author": "Kurt Dowswell",
  "type": "module",
  "bin": {
    "hitl-ui": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup && tsx scripts/build-registry.ts && chmod +x dist/index.js",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "commander": "^12.1.0",
    "globby": "^14.0.2",
    "jiti": "^2.4.2",
    "picocolors": "^1.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "hitl-ui-components": "workspace:*",
    "@types/node": "^22.10.2",
    "execa": "^9.5.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
