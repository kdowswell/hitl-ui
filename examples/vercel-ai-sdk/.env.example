# Provider selection. Pick ONE path. The first non-empty match wins.
# Resolution order: AI_PROVIDER override → AI_GATEWAY_API_KEY → OPENAI_API_KEY → Ollama (local default)
#
# Force a specific path:
# AI_PROVIDER=gateway
# AI_PROVIDER=openai
# AI_PROVIDER=ollama

# ─── Path A — Vercel AI Gateway ─────────────────────────────────────────────
# RECOMMENDED for AI SDK users: one key for any provider, free tier, swap
# models with one string change, native to the SDK.
# Get a key at https://vercel.com/dashboard/ai-gateway
#
# AI_GATEWAY_API_KEY=vck_...
#
# Pick any model (provider/model-id format). Defaults to anthropic/claude-haiku-4-5
# (cheap, fast, excellent tool-calling reliability).
# AI_GATEWAY_MODEL=anthropic/claude-haiku-4-5      # default — fast/cheap
# AI_GATEWAY_MODEL=anthropic/claude-sonnet-4-6     # higher quality
# AI_GATEWAY_MODEL=anthropic/claude-opus-4-7       # top-tier reasoning
# AI_GATEWAY_MODEL=openai/gpt-5-mini               # cheap OpenAI
# AI_GATEWAY_MODEL=openai/gpt-5                    # top OpenAI
# AI_GATEWAY_MODEL=google/gemini-2.5-flash         # cheap Google
# AI_GATEWAY_MODEL=google/gemini-2.5-pro           # top Google

# ─── Path B — OpenAI direct ─────────────────────────────────────────────────
# Use if you already have an OpenAI key and don't want to set up the Gateway.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5-mini

# ─── Path C — Ollama (local, free, OSS) ─────────────────────────────────────
# OSS-aligned default if no other env vars are set. Install Ollama and pull
# a tool-capable model first; see README.md for model recommendations.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b   # default — gold standard for local tool calling
# OLLAMA_MODEL=gpt-oss:20b   # OpenAI's open-weights model, strong agent tasks
# OLLAMA_MODEL=llama3.3:70b  # heavy but ~GPT-4 class
