# Defaults to local Ollama if neither OPENAI_API_KEY nor AI_PROVIDER is set.
# The OSS-aligned recommended path: install Ollama, pull a model, leave this file untouched.
#
# Forced provider override:
# AI_PROVIDER=openai
# AI_PROVIDER=ollama

# OpenAI (cloud, paid, best tool-calling reliability):
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Ollama (local, free, OSS):
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2
