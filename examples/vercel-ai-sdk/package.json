{
  "name": "examples-vercel-ai-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Demo: hitl-ui assess + decide rendered live by an agent powered by Vercel AI SDK v6. Default provider is local Ollama; OpenAI is a one-env-var fallback.",
  "type": "module",
  "scripts": {
    "install:components": "node ../../packages/cli/dist/index.js add assess --force && node ../../packages/cli/dist/index.js add decide --force",
    "predev": "pnpm install:components",
    "dev": "next dev -p 3001",
    "prebuild": "pnpm install:components",
    "build": "next build",
    "start": "next start -p 3001",
    "pretypecheck": "pnpm install:components",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next node_modules components/hitl-ui tools/hitl-ui instructions/hitl-ui"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^3.0.109",
    "@ai-sdk/openai": "^3.0.58",
    "@ai-sdk/react": "^3.0.0",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-switch": "^1.1.2",
    "ai": "^6.0.174",
    "clsx": "^2.1.1",
    "next": "^16.0.0",
    "ollama-ai-provider-v2": "^3.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@kdowswell/hitl-ui": "workspace:*",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3"
  }
}
