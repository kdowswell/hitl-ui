{
  "name": "hitl-ui-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Human-in-the-loop UI components for AI agents — installable triads of React component + tool definition + agent instructions.",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "storybook": "pnpm -F @kdowswell/hitl-ui-components storybook",
    "build-storybook": "turbo run build-storybook",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@changesets/cli": "^2.27.10",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
